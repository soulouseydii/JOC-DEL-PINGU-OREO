<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>

<BorderPane styleClass="root" stylesheets="@PantallaMenu.css" xmlns="http://javafx.com/javafx/25" xmlns:fx="http://javafx.com/fxml/1" fx:controller="VISTA.PantallaInicio">
    <top>
        <VBox>
            <!-- Barra de título -->
            <HBox alignment="CENTER_RIGHT" onMouseDragged="#onTitleBarDragged" onMousePressed="#onTitleBarPressed" prefHeight="30.0" styleClass="title-bar">
                <padding>
                    <Insets bottom="5" left="10" right="5" top="5" />
                </padding>
                
                <Label styleClass="title-bar-label" text="El Juego del Pingüino" />
                <Region HBox.hgrow="ALWAYS" />
                
                <HBox alignment="CENTER" spacing="5">
                    <Button mnemonicParsing="false" onAction="#minimizarVentana" styleClass="window-btn" text="—" />
                    <Button mnemonicParsing="false" onAction="#maximizarVentana" styleClass="window-btn" text="⬜" />
                    <Button mnemonicParsing="false" onAction="#cerrarVentana" styleClass="window-btn, window-btn-close" text="X" />
                </HBox>
            </HBox>
        </VBox>
    </top>

    <center>
        <StackPane styleClass="main-container">
            <!-- Contenedor de botones posicionado a la derecha, dentro del panel de hielo -->
            <VBox alignment="CENTER" spacing="22" styleClass="menu-buttons-panel" StackPane.alignment="CENTER_RIGHT">
                <padding>
                    <Insets bottom="80" left="30" right="60" top="40" />
                </padding>

                <Button fx:id="btnNuevaPartida" onAction="#handleNuevaPartida" prefHeight="65.0" prefWidth="320.0" styleClass="ice-btn" text="Nueva Partida" />
                <Button fx:id="btnCargarPartida" onAction="#handleCargarPartida" prefHeight="65.0" prefWidth="320.0" styleClass="ice-btn" text="Cargar Partida" />
                <Button fx:id="btnOpciones" onAction="#handleOpciones" prefHeight="65.0" prefWidth="320.0" styleClass="ice-btn" text="Opciones" />
                <Button fx:id="btnSalir" onAction="#handleSalir" prefHeight="65.0" prefWidth="320.0" styleClass="ice-btn, ice-btn-exit" text="Salir" />
            </VBox>
        </StackPane>
    </center>
</BorderPane>
