<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.CheckBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.Slider?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>

<BorderPane styleClass="root" stylesheets="@PantallaMenu.css" xmlns="http://javafx.com/javafx/25" xmlns:fx="http://javafx.com/fxml/1" fx:controller="VISTA.PantallaInicio">

    <center>
        <StackPane prefHeight="700.0" prefWidth="1123.0">
            <padding>
                <Insets bottom="28.0" left="28.0" right="28.0" top="28.0" />
            </padding>
            <VBox fx:id="paneOpciones" alignment="CENTER" maxHeight="500" maxWidth="500" spacing="20" style="-fx-background-color: rgba(173, 216, 230, 0.9); -fx-background-radius: 15; -fx-border-color: white; -fx-border-radius: 15; -fx-border-width: 3;" visible="false">
                <padding>
                    <Insets bottom="30" left="40" right="40" top="30" />
                </padding>
                <Label style="-fx-font-size: 32; -fx-font-weight: bold; -fx-text-fill: #2c3e50;" text="OPCIONES" />
                
                <VBox alignment="CENTER_LEFT" spacing="10" style="-fx-background-color: rgba(255, 255, 255, 0.6); -fx-background-radius: 10; -fx-padding: 15;">
                    <Label style="-fx-font-size: 20; -fx-font-weight: bold; -fx-text-fill: #2c3e50;" text="AUDIO" />
                    <HBox alignment="CENTER_LEFT" spacing="20">
                        <CheckBox fx:id="chkMusica" onAction="#handleChkMusica" selected="true" style="-fx-font-size: 16; -fx-text-fill: #2c3e50;" text="Música" />
                        <Region HBox.hgrow="ALWAYS" />
                        <Slider fx:id="sliderMusica" max="100" onMouseReleased="#handleSliderMusica" prefWidth="150" value="50" />
                    </HBox>
                    <HBox alignment="CENTER_LEFT" spacing="20">
                        <CheckBox fx:id="chkSonido" onAction="#handleChkSonido" selected="true" style="-fx-font-size: 16; -fx-text-fill: #2c3e50;" text="Efectos de Sonido" />
                        <Region HBox.hgrow="ALWAYS" />
                        <Slider fx:id="sliderSonido" max="100" onMouseReleased="#handleSliderSonido" prefWidth="150" value="50" />
                    </HBox>
                </VBox>

                <VBox alignment="CENTER_LEFT" spacing="10" style="-fx-background-color: rgba(255, 255, 255, 0.6); -fx-background-radius: 10; -fx-padding: 15;">
                    <Label style="-fx-font-size: 20; -fx-font-weight: bold; -fx-text-fill: #2c3e50;" text="VISUAL" />
                    <CheckBox fx:id="chkAnimaciones" onAction="#handleChkAnimaciones" selected="true" style="-fx-font-size: 16; -fx-text-fill: #2c3e50;" text="Animaciones" />
                    <CheckBox fx:id="chkPantallaCompleta" onAction="#handleChkPantallaCompleta" selected="true" style="-fx-font-size: 16; -fx-text-fill: #2c3e50;" text="Pantalla Completa" />
                </VBox>
                
                <Button onAction="#cerrarOpciones" prefHeight="45" prefWidth="250" style="-fx-background-color: #2c3e50; -fx-text-fill: white; -fx-font-size: 16; -fx-font-weight: bold; -fx-background-radius: 10; -fx-cursor: hand;" text="Volver" />
            </VBox>
        </StackPane>
    </center>
   <left>

         <!-- Botones del Menú Principal -->
         <VBox alignment="BOTTOM_CENTER" maxHeight="-Infinity" maxWidth="1096.0" prefHeight="627.0" prefWidth="614.0" spacing="15" BorderPane.alignment="CENTER">
             <Button fx:id="btnNuevaPartida" onAction="#handleNuevaPartida" prefHeight="58.0" prefWidth="281.0" styleClass="primary" text="Nueva Partida" />
             <Button fx:id="btnCargarPartida" onAction="#handleCargarPartida" prefHeight="60.0" prefWidth="279.0" styleClass="primary" text="Cargar Partida" />
             <Button fx:id="btnOpciones" onAction="#handleOpciones" prefHeight="62.0" prefWidth="274.0" styleClass="primary" text="Opciones" />
             <Button fx:id="btnSalir" onAction="#handleSalir" prefHeight="65.0" prefWidth="277.0" text="Salir del Juego" />
         </VBox>
   </left>
</BorderPane>
