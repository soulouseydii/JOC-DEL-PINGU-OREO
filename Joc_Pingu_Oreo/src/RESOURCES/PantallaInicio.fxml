<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.CheckBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.Slider?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>

<BorderPane styleClass="root" stylesheets="@PantallaMenu.css" xmlns="http://javafx.com/javafx/25" xmlns:fx="http://javafx.com/fxml/1" fx:controller="VISTA.PantallaInicio">

    <center>
        <StackPane prefHeight="700.0" prefWidth="1123.0">
            <padding>
                <Insets bottom="28.0" left="28.0" right="28.0" top="28.0" />
            </padding>
            <!-- Botones del Menú Principal (centrados) -->
            <VBox fx:id="menuPrincipal" alignment="CENTER" spacing="15" maxWidth="320" StackPane.alignment="CENTER">
                <Button fx:id="btnNuevaPartida" onAction="#handleNuevaPartida" prefHeight="58.0" maxWidth="Infinity" styleClass="primary" text="Nueva Partida" />
                <Button fx:id="btnCargarPartida" onAction="#handleCargarPartida" prefHeight="58.0" maxWidth="Infinity" styleClass="primary" text="Cargar Partida" />
                <Button fx:id="btnOpciones" onAction="#handleOpciones" prefHeight="58.0" maxWidth="Infinity" styleClass="primary" text="Opciones" />
                <Button fx:id="btnSalir" onAction="#handleSalir" prefHeight="58.0" maxWidth="Infinity" styleClass="btn-exit" text="Salir del Juego" />
            </VBox>
            <!-- Panel de Opciones (encima del menú, visible=false por defecto) -->
            <VBox fx:id="paneOpciones" alignment="CENTER" maxHeight="500" maxWidth="500" spacing="20" style="-fx-background-color: linear-gradient(to bottom right, rgba(10, 30, 60, 1.0), rgba(5, 55, 90, 1.0)); -fx-background-radius: 24; -fx-border-color: rgba(130, 210, 255, 0.5); -fx-border-radius: 24; -fx-border-width: 2;" visible="false">
                <padding>
                    <Insets bottom="30" left="40" right="40" top="30" />
                </padding>
                <Label style="-fx-font-size: 30; -fx-font-weight: 900; -fx-text-fill: #d0f0ff; -fx-effect: dropshadow(gaussian, rgba(100,200,255,0.5), 10, 0.4, 0, 0);" text="OPCIONES" />
                
                <VBox alignment="CENTER_LEFT" spacing="10" style="-fx-background-color: rgba(255,255,255,0.05); -fx-background-radius: 12; -fx-border-color: rgba(130,210,255,0.2); -fx-border-radius: 12; -fx-border-width: 1; -fx-padding: 15;">
                    <Label style="-fx-font-size: 18; -fx-font-weight: 900; -fx-text-fill: rgba(130,210,255,0.85);" text="AUDIO" />
                    <HBox alignment="CENTER_LEFT" spacing="20">
                        <CheckBox fx:id="chkMusica" onAction="#handleChkMusica" selected="true" style="-fx-font-size: 15; -fx-text-fill: #c8eeff;" text="Música" />
                        <Region HBox.hgrow="ALWAYS" />
                        <Slider fx:id="sliderMusica" max="100" onMouseReleased="#handleSliderMusica" prefWidth="150" value="50" />
                    </HBox>
                    <HBox alignment="CENTER_LEFT" spacing="20">
                        <CheckBox fx:id="chkSonido" onAction="#handleChkSonido" selected="true" style="-fx-font-size: 15; -fx-text-fill: #c8eeff;" text="Efectos de Sonido" />
                        <Region HBox.hgrow="ALWAYS" />
                        <Slider fx:id="sliderSonido" max="100" onMouseReleased="#handleSliderSonido" prefWidth="150" value="50" />
                    </HBox>
                </VBox>

                <VBox alignment="CENTER_LEFT" spacing="10" style="-fx-background-color: rgba(255,255,255,0.05); -fx-background-radius: 12; -fx-border-color: rgba(130,210,255,0.2); -fx-border-radius: 12; -fx-border-width: 1; -fx-padding: 15;">
                    <Label style="-fx-font-size: 18; -fx-font-weight: 900; -fx-text-fill: rgba(130,210,255,0.85);" text="VISUAL" />
                    <CheckBox fx:id="chkAnimaciones" onAction="#handleChkAnimaciones" selected="true" style="-fx-font-size: 15; -fx-text-fill: #c8eeff;" text="Animaciones" />
                    <CheckBox fx:id="chkPantallaCompleta" onAction="#handleChkPantallaCompleta" selected="true" style="-fx-font-size: 15; -fx-text-fill: #c8eeff;" text="Pantalla Completa" />
                </VBox>
                
                <Button onAction="#cerrarOpciones" prefHeight="45" prefWidth="250" style="-fx-background-color: linear-gradient(to bottom right, rgba(255,255,255,0.08), rgba(100,180,255,0.18)); -fx-text-fill: #d0f0ff; -fx-font-size: 16; -fx-font-weight: 900; -fx-background-radius: 14; -fx-border-color: rgba(130,210,255,0.5); -fx-border-radius: 14; -fx-border-width: 1.5; -fx-cursor: hand;" text="Volver" />
            </VBox>
        </StackPane>
    </center>
</BorderPane>
