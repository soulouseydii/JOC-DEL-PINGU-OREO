<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>

<BorderPane styleClass="root" stylesheets="@PantallaMenu.css" xmlns="http://javafx.com/javafx/25" xmlns:fx="http://javafx.com/fxml/1" fx:controller="VISTA.PantallaInicio">

    <center>
        <StackPane prefHeight="700.0" prefWidth="1123.0">
            <padding>
                <Insets bottom="28.0" left="28.0" right="28.0" top="28.0" />
            </padding>
        </StackPane>
    </center>
   <left>

         <!-- Botones del Menú Principal -->
         <VBox alignment="BOTTOM_CENTER" maxHeight="-Infinity" maxWidth="1096.0" prefHeight="858.0" prefWidth="479.0" spacing="15" BorderPane.alignment="CENTER">
             <Button fx:id="btnNuevaPartida" onAction="#handleNuevaPartida" prefHeight="45.0" prefWidth="250.0" styleClass="primary" text="Nueva Partida" />
             <Button fx:id="btnCargarPartida" onAction="#handleCargarPartida" prefHeight="45.0" prefWidth="250.0" styleClass="primary" text="Cargar Partida" />
             <Button fx:id="btnOpciones" onAction="#handleOpciones" prefHeight="45.0" prefWidth="250.0" styleClass="primary" text="Opciones" />
             <Button fx:id="btnSalir" onAction="#handleSalir" prefHeight="45.0" prefWidth="250.0" text="Salir del Juego" />
         </VBox>
   </left>
</BorderPane>
