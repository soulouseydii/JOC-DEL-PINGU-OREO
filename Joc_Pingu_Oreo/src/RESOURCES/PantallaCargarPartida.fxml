<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ListView?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>

<BorderPane styleClass="root" stylesheets="@PantallaMenu.css" xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1" fx:controller="VISTA.PantallaCargarPartida">
    <top>
        <VBox>
            <!-- Barra de título -->
            <HBox alignment="CENTER_RIGHT" onMouseDragged="#onTitleBarDragged" onMousePressed="#onTitleBarPressed" prefHeight="30.0" style="-fx-background-color: #2c3e50;">
                <padding>
                    <Insets bottom="5" left="10" right="5" top="5" />
                </padding>
                
                <Label text="Juego del Pingu Oreo - Cargar Partida" textFill="WHITE" />
                <Region HBox.hgrow="ALWAYS" />
                
                <HBox spacing="5" alignment="CENTER">
                    <Button mnemonicParsing="false" onAction="#minimizarVentana" style="-fx-background-color: transparent; -fx-text-fill: white; -fx-cursor: hand;" text="—" />
                    <Button mnemonicParsing="false" onAction="#maximizarVentana" style="-fx-background-color: transparent; -fx-text-fill: white; -fx-cursor: hand;" text="⬜" />
                    <Button mnemonicParsing="false" onAction="#cerrarVentana" style="-fx-background-color: transparent; -fx-text-fill: white; -fx-cursor: hand;" text="X" />
                </HBox>
            </HBox>
        </VBox>
    </top>

    <center>
        <StackPane prefHeight="700.0" prefWidth="1000.0">
            <padding>
                <Insets bottom="28" left="28" right="28" top="28" />
            </padding>

            <!-- Contenedor Principal de la vista de Cargar Partida -->
            <VBox alignment="CENTER" maxWidth="500" spacing="16" style="-fx-background-color: rgba(255, 255, 255, 0.6);" styleClass="card">
                <padding>
                    <Insets bottom="18" left="18" right="18" top="18" />
                </padding>

                <!-- Título -->
                <VBox alignment="CENTER" prefHeight="48.0" prefWidth="394.0" spacing="6" style="-fx-background-color: rgba(255, 255, 255, 0.4); -fx-background-radius: 15;">
                    <Label styleClass="title" text="CARGAR PARTIDA" wrapText="true" />
                </VBox>

                <Region prefHeight="10" />

                <!-- Lista de Partidas -->
                <ListView fx:id="listaPartidas" prefHeight="250.0" style="-fx-background-color: white; -fx-background-radius: 10;" />

                <Region prefHeight="10" />

                <!-- Botones de Acción -->
                <HBox spacing="15" alignment="CENTER">
                    <Button fx:id="btnCargar" onAction="#handleCargar" styleClass="primary" text="Cargar Partida" />
                    <Button fx:id="btnEliminar" onAction="#handleEliminar" styleClass="primary" text="Eliminar Partida" />
                </HBox>

                <Region prefHeight="10" />

                <!-- Botón Volver -->
                <Button fx:id="btnVolver" maxWidth="Infinity" onAction="#handleVolver" text="Volver al Menú Principal" />
            </VBox>

            <!-- Overlay de Confirmación (oculto por defecto) -->
            <VBox fx:id="overlayConfirmacion" alignment="CENTER" visible="false" style="-fx-background-color: rgba(0, 0, 0, 0.7);">
                <VBox alignment="CENTER" maxWidth="350" spacing="20" style="-fx-background-color: white; -fx-background-radius: 15; -fx-padding: 20;">
                    <Label style="-fx-font-size: 16px; -fx-font-weight: bold; -fx-text-fill: black;" text="¿Estás seguro de borrar la partida?" wrapText="true" />
                    <HBox spacing="20" alignment="CENTER">
                        <Button onAction="#confirmarBorrado" styleClass="primary" text="Sí" />
                        <Button onAction="#cancelarBorrado" text="No" />
                    </HBox>
                </VBox>
            </VBox>

        </StackPane>
    </center>
</BorderPane>
