<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>

<BorderPane styleClass="root" stylesheets="@PantallaMenu.css" xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1" fx:controller="VISTA.PantallaConfiguracionPartida">
    <top>
        <VBox>
            <HBox alignment="CENTER_RIGHT" onMouseDragged="#onTitleBarDragged" onMousePressed="#onTitleBarPressed" prefHeight="30.0" style="-fx-background-color: #2c3e50;">
                <padding><Insets bottom="5" left="10" right="5" top="5" /></padding>
                
                <Label text="Juego del Pingu Oreo - Nueva Partida" textFill="WHITE" />
                <Region HBox.hgrow="ALWAYS" />
                
                <HBox spacing="5" alignment="CENTER">
                    <Button mnemonicParsing="false" onAction="#minimizarVentana" style="-fx-background-color: transparent; -fx-text-fill: white; -fx-cursor: hand;" text="—" />
                    <Button mnemonicParsing="false" onAction="#maximizarVentana" style="-fx-background-color: transparent; -fx-text-fill: white; -fx-cursor: hand;" text="⬜" />
                    <Button mnemonicParsing="false" onAction="#cerrarVentana" style="-fx-background-color: transparent; -fx-text-fill: white; -fx-cursor: hand;" text="X" />
                </HBox>
            </HBox>
        </VBox>
    </top>

    <center>
        <StackPane prefHeight="700.0" prefWidth="1200.0">
            <padding><Insets bottom="28" left="28" right="28" top="28" /></padding>

            <VBox alignment="CENTER" maxWidth="1000" spacing="20" style="-fx-background-color: rgba(255, 255, 255, 0.6);" styleClass="card">
                <padding><Insets bottom="20" left="20" right="20" top="20" /></padding>

                <!-- Título -->
                <VBox alignment="CENTER" prefHeight="48.0" prefWidth="800.0" spacing="6" style="-fx-background-color: rgba(255, 255, 255, 0.4); -fx-background-radius: 15;">
                    <Label styleClass="title" text="CONFIGURACIÓN DE LA PARTIDA" wrapText="true" />
                </VBox>

                <!-- Selector de Jugadores -->
                <HBox spacing="15" alignment="CENTER">
                    <Label style="-fx-font-size: 16px; -fx-font-weight: bold;" text="Número de Jugadores:" />
                    <ComboBox fx:id="comboNumJugadores" onAction="#onNumJugadoresChanged" prefWidth="100.0" />
                </HBox>

                <!-- Contenedor de Tarjetas de Jugadores (Generado Dinámicamente) -->
                <HBox fx:id="contenedorJugadores" spacing="20" alignment="CENTER" VBox.vgrow="ALWAYS">
                    <!-- Tarjetas insertadas por PantallaConfiguracionPartida.java -->
                </HBox>

                <Region prefHeight="10" />

                <!-- Botones Finales -->
                <HBox spacing="15" alignment="CENTER">
                    <Button fx:id="btnEmpezar" onAction="#handleEmpezar" disable="true" styleClass="primary" text="Empezar Partida" />
                </HBox>
                
                <Region prefHeight="5" />
                <Button fx:id="btnVolver" maxWidth="250" onAction="#handleVolver" text="Volver al Menú Principal" />
            </VBox>
        </StackPane>
    </center>
</BorderPane>
