<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>

<BorderPane styleClass="root" stylesheets="@PantallaMenu.css" xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1" fx:controller="VISTA.PantallaConfiguracionPartida">
    <top>
        <VBox>
            <HBox alignment="CENTER_LEFT" onMouseDragged="#onTitleBarDragged" onMousePressed="#onTitleBarPressed" prefHeight="36.0" style="-fx-background-color: linear-gradient(to right, rgba(5,15,35,0.98), rgba(5,55,90,0.95)); -fx-border-color: transparent transparent rgba(130,210,255,0.3) transparent; -fx-border-width: 0 0 1 0;">
                <padding>
                    <Insets bottom="6" left="16" right="8" top="6" />
                </padding>
                <Label text="❄  El Juego del Pinguino — Nueva Partida" style="-fx-text-fill: rgba(200,230,255,0.7); -fx-font-size: 13px; -fx-font-weight: bold;" />
                <Region HBox.hgrow="ALWAYS" />
                <HBox spacing="4" alignment="CENTER">
                    <Button mnemonicParsing="false" onAction="#minimizarVentana" style="-fx-background-color: rgba(255,255,255,0.06); -fx-text-fill: rgba(200,230,255,0.7); -fx-cursor: hand; -fx-background-radius: 6; -fx-padding: 2 8; -fx-border-color: transparent; -fx-font-size: 13px;" text="—" />
                    <Button mnemonicParsing="false" onAction="#maximizarVentana" style="-fx-background-color: rgba(255,255,255,0.06); -fx-text-fill: rgba(200,230,255,0.7); -fx-cursor: hand; -fx-background-radius: 6; -fx-padding: 2 8; -fx-border-color: transparent; -fx-font-size: 12px;" text="⬜" />
                    <Button mnemonicParsing="false" onAction="#cerrarVentana" style="-fx-background-color: rgba(200,50,50,0.3); -fx-text-fill: rgba(255,180,180,0.9); -fx-cursor: hand; -fx-background-radius: 6; -fx-padding: 2 10; -fx-border-color: transparent; -fx-font-weight: bold;" text="✕" />
                </HBox>
            </HBox>
        </VBox>
    </top>

    <center>
        <StackPane prefHeight="700.0" prefWidth="1200.0">
            <padding>
                <Insets bottom="36" left="40" right="40" top="28" />
            </padding>

            <VBox alignment="CENTER" maxWidth="1050" spacing="0" styleClass="dark-panel">
                <padding>
                    <Insets bottom="36" left="40" right="40" top="36" />
                </padding>

                <!-- Encabezado -->
                <VBox alignment="CENTER" spacing="6" style="-fx-padding: 0 0 20 0;">
                    <Label text="🎮" style="-fx-font-size: 40px;" />
                    <Label text="NUEVA PARTIDA" styleClass="panel-title" />
                    <Label text="Configura los jugadores antes de empezar" styleClass="panel-subtitle" />
                </VBox>

                <!-- Separador -->
                <Region prefHeight="1" maxWidth="600" style="-fx-background-color: rgba(130,210,255,0.25);" />
                <Region prefHeight="22" />

                <!-- Nombre de la partida -->
                <HBox spacing="18" alignment="CENTER" style="-fx-background-color: rgba(255,255,255,0.04); -fx-background-radius: 12; -fx-border-color: rgba(130,210,255,0.2); -fx-border-radius: 12; -fx-border-width: 1; -fx-padding: 14 24;">
                    <Label style="-fx-font-size: 16px; -fx-font-weight: 900; -fx-text-fill: #c8eeff;" text="Nombre de la partida:" />
                    <javafx.scene.control.TextField fx:id="txtNombrePartida" promptText="Pingüino Aventura..." style="-fx-background-color: rgba(255,255,255,0.07); -fx-background-radius: 8; -fx-border-color: rgba(130,210,255,0.3); -fx-border-radius: 8; -fx-text-fill: #d0f0ff; -fx-prompt-text-fill: rgba(160,210,255,0.35); -fx-padding: 7 10;" prefWidth="250"/>
                </HBox>
                <Label fx:id="lblErrorNombre" text="⚠ Debes ponerle un nombre a la partida" managed="false" visible="false" style="-fx-text-fill: #ff6e6e; -fx-font-size: 12px; -fx-font-weight: bold; -fx-padding: 5 0 0 0;"/>
                
                <Region prefHeight="15" />

                <!-- Selector de número de jugadores -->
                <HBox spacing="18" alignment="CENTER" style="-fx-background-color: rgba(255,255,255,0.04); -fx-background-radius: 12; -fx-border-color: rgba(130,210,255,0.2); -fx-border-radius: 12; -fx-border-width: 1; -fx-padding: 14 24;">
                    <Label style="-fx-font-size: 16px; -fx-font-weight: 900; -fx-text-fill: #c8eeff;" text="Número de Jugadores:" />
                    <ComboBox fx:id="comboNumJugadores" onAction="#onNumJugadoresChanged" prefWidth="110.0" styleClass="dark-combo" />
                </HBox>

                <Region prefHeight="22" />

                <!-- Tarjetas de jugadores (dinámicas) -->
                <HBox fx:id="contenedorJugadores" spacing="18" alignment="CENTER" VBox.vgrow="ALWAYS" />

                <Region prefHeight="24" />

                <!-- Botones finales -->
                <HBox spacing="16" alignment="CENTER">
                    <Button fx:id="btnEmpezar" onAction="#handleEmpezar" disable="true" styleClass="dark-btn-primary" text="▶  Empezar Partida" prefWidth="220" prefHeight="48" />
                </HBox>

                <Region prefHeight="12" />
                <Button fx:id="btnVolver" maxWidth="260" onAction="#handleVolver" styleClass="dark-btn-secondary" text="← Volver al Menú" prefHeight="40" />
            </VBox>

        </StackPane>
    </center>
</BorderPane>
